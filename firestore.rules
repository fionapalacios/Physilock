rules_version = '2';

// Physi-Lock Firestore security rules.
// This file isn't auto-deployed (no Firebase CLI configured in this repo) — paste its
// contents into Firebase Console → Firestore Database → Rules, or deploy with
// `firebase deploy --only firestore:rules` once the CLI is set up.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /users/{userId} {
      // You can read your own profile (fetchAccount after login); Admin can read/query
      // any profile, including the full account list for the Admin dashboard.
      // Username/email uniqueness checks during registration go through the separate
      // /usernames lookup below instead of querying this collection directly.
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if request.auth != null && isAdmin();

      // You can only create your own profile document (id must match your own uid),
      // and only as a plain USER — role can't be self-assigned at signup.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == 'USER';

      // You can update your own profile, but never your own `role` or `isActive` —
      // those are Admin-only (account activation/deactivation, privilege changes).
      // Admin can update/delete any profile without restriction.
      allow update: if request.auth != null &&
        (isAdmin() ||
         (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isActive == resource.data.isActive));

      allow delete: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
    }

    // Public username -> email lookup, used to resolve a username to an email before
    // sign-in (login-by-username), and also by register/update/suggestUsername's own
    // uniqueness checks (querying /users directly by username is no longer allowed for
    // non-admins above, so those checks use this exact-key lookup instead). Deliberately
    // minimal: each doc holds nothing but { email }, and only exact-ID `get` is allowed —
    // never `list` — so the collection can't be enumerated, only looked up if you already
    // know the exact username.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;

      // Create/overwrite only your own mapping: either the doc doesn't exist yet
      // (fresh registration) or it already points at your own email (renaming your
      // username later), and you must be setting it to your own email either way.
      // (Split as create/update rather than `write` so it doesn't also have to
      // account for delete, which has no request.resource to check.)
      allow create, update: if request.auth != null &&
        (resource == null || resource.data.email == request.auth.token.email) &&
        request.resource.data.email == request.auth.token.email;

      // Only the owner (by email) can remove their own mapping, e.g. when renaming.
      allow delete: if request.auth != null &&
        resource.data.email == request.auth.token.email;
    }
  }
}
